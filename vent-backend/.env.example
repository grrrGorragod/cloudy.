# คัดลอกเป็น .env แล้วใส่ค่าจริง (ห้ามเอา .env ขึ้น git)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
OPENAI_API_KEY=sk-...

# โดเมนของหน้าเว็บที่เรียก API ได้ คั่นด้วยจุลภาค
CORS_ORIGINS=http://localhost:5173

PORT=3000

# รัน Postgres ในเครื่องโดยไม่มี SSL ให้เปิดบรรทัดนี้
# PGSSL=disable

# ปรับได้ถ้าต้องการ (ค่าเริ่มต้นตามนี้)
# MAX_POSTS_PER_DAY=5
# MAX_REPLIES_PER_HOUR=40
# MAX_REPLIES_PER_POST=10
# REPORT_MIN_ACCOUNT_HOURS=24
# REPORT_MAX_PER_DAY=10
# REPORT_HIDE_AT=3
# MOD_THRESHOLDS={"block":{"harassment":0.75},"warn":{"sexual":0.5}}
